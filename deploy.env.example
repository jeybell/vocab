# deploy.sh 가 읽는 서버별 설정입니다.
# 이 파일을 deploy.env 로 복사한 뒤 값을 채워 서버에만 두세요.
# deploy.env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.
#
#   cp deploy.env.example deploy.env
#
# Expo Go에 알려줄 주소. 서버의 공인 IP 또는 도메인입니다.
PUBLIC_HOST=

# Expo 액세스 토큰 (앱/Expo Go 접속용, 웹만 쓸 경우 비워두어도 됩니다).
#
# Expo Go는 로컬 네트워크 밖의 개발 서버에 붙을 때 CLI와 Expo Go가 같은
# 계정으로 로그인되어 있기를 요구합니다. 이 서버는 공인 IP로 서비스하므로
# 여기에 해당하며, 비워두면 Expo Go에서 로그인 요구 화면이 뜹니다.
#
# 발급: expo.dev 로그인 -> 우측 상단 계정 -> Settings -> Access tokens
#       -> Create token
# 그리고 휴대폰 Expo Go 앱에서도 같은 계정으로 로그인해야 합니다.
EXPO_TOKEN=
